# Runflare Docker service: copy to its Bulk Edit environment editor.
NODE_ENV=production
PORT=3000
# Keep the existing product origin and append the exact admin origin to this comma-separated allowlist.
WEB_ORIGIN=https://<owner-verified-product-origin>,https://admin.shoproapp.ir
# Hostname whose root URL redirects into the protected admin panel.
ADMIN_APP_ORIGIN=https://admin.shoproapp.ir
# Optional landing host served by this same Docker item on PORT 3000.
MARKETING_PUBLIC_URL=https://<owner-verified-landing-origin>
# Origin used by landing-page entry buttons.
PRODUCT_URL=https://<owner-verified-product-origin>
# Set this to the number of trusted reverse proxies between Runflare and the container.
TRUST_PROXY_HOPS=1
DATABASE_URL=<connection-string-from-the-Runflare-PostgreSQL-service>
SESSION_SECRET=<unique-random-secret-at-least-32-characters>
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=5
OTP_HASH_SECRET=<different-unique-random-secret-at-least-32-characters>
STOREFRONT_CARD_ENCRYPTION_KEY=<independent-random-32-byte-key-base64url-or-64-char-hex>
PARSGREEN_API_KEY=<ParsGreen-API-token>
PARSGREEN_BASE_URL=https://sms.parsgreen.ir
PARSGREEN_TIMEOUT_MS=10000
# Required for private expense and subscription receipt upload/download; set to the absolute mount path of a durable private volume.
ATTACHMENT_STORAGE_DIR=
# Optional Telegram Bot API token. Store as a Runflare Secret; never commit the token.
TELEGRAM_BOT_TOKEN=
SHOPRO_ADMIN_USERNAME=shopro_super_admin
# Owner enters the initial value directly as a Runflare Secret for the first bootstrap only.
SHOPRO_ADMIN_INITIAL_PASSWORD=<owner-sets-directly-in-Runflare>
