# Runflare Docker service: copy to its Bulk Edit environment editor.
NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://<runflare-domain>
# Set this to the number of trusted reverse proxies between Runflare and the container.
TRUST_PROXY_HOPS=1
DATABASE_URL=<connection-string-from-the-Runflare-PostgreSQL-service>
SESSION_SECRET=<unique-random-secret-at-least-32-characters>
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_PER_PHONE_HOUR=5
OTP_HASH_SECRET=<different-unique-random-secret-at-least-32-characters>
PARSGREEN_API_KEY=<ParsGreen-API-token>
PARSGREEN_BASE_URL=https://sms.parsgreen.ir
PARSGREEN_TIMEOUT_MS=10000
# Leave empty until a private persistent volume is available; then use its absolute mount path.
ATTACHMENT_STORAGE_DIR=
