# Run only in a dedicated backup runner with Node.js 22 and matching PostgreSQL tools.
# Never copy this file into the app service without deciding that service's secret boundary.
DATABASE_URL=
ATTACHMENT_STORAGE_DIR=
BACKUP_DIR=
BACKUP_RETENTION_DAYS=
BACKUP_ENCRYPTION_KEY=

# Restore-only variables. The restore CLI accepts loopback PostgreSQL targets only.
RESTORE_DATABASE_URL=
RESTORE_CONFIRM_DATABASE=
RESTORE_ATTACHMENT_STORAGE_DIR=
