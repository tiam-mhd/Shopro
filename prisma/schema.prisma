generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DisplayCurrency {
  IRR
  IRT
}

enum MemberRole {
  OWNER
  MANAGER
  ACCOUNTANT
  CASHIER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  USER_LOGIN
  ADMIN_LOGIN
  STOREFRONT_CHECKOUT
}

enum StorefrontStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum StorefrontOrderStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  EXPIRED
  RETURNED
}

enum StorefrontPaymentStatus {
  NOT_DUE
  UNPAID
  RECEIPT_SUBMITTED
  UNDER_REVIEW
  PARTIALLY_VERIFIED
  OVERPAID_REVIEW
  VERIFIED
  REFUND_PENDING
  REFUNDED
}

enum StorefrontPaymentAttemptStatus {
  UNDER_REVIEW
  REJECTED
  PARTIALLY_VERIFIED
  OVERPAID_REVIEW
  VERIFIED
}

enum StorefrontDeliveryMethod {
  PICKUP
  LOCAL_DELIVERY
}

enum StorefrontListingStockPolicy {
  EXACT
  APPROXIMATE
  INQUIRY
}

enum ProductKind {
  STOCK
  SERVICE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinanceAccountKind {
  CASH
  BANK
  POS
  OTHER
}

enum InvoiceStatus {
  DRAFT
  POSTED
  VOIDED
}

enum PurchaseStatus {
  DRAFT
  POSTED
  VOIDED
}

enum ExpenseStatus {
  DRAFT
  POSTED
  VOIDED
}

enum CashTransactionKind {
  RECEIPT
  PAYMENT
  TRANSFER
  OPENING
}

enum PaymentMethod {
  CASH
  POS
  BANK
  CREDIT
  OTHER
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum StockCountStatus {
  DRAFT
  POSTED
}

enum SyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CONFLICT
}

enum SubscriptionRolloutMode {
  OBSERVE
  ENFORCE
}

enum SubscriptionOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ManualPaymentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TelegramDeliveryStatus {
  NOT_CONFIGURED
  PENDING
  SENT
  FAILED
}

enum SubscriptionPaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  UNAVAILABLE
  REFUNDED
}

enum SubscriptionPeriodSource {
  PAID_ORDER
  ADMIN_GRANT
  ADMIN_EXTENSION
  COMPENSATION
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  phone              String              @unique @db.VarChar(20)
  displayName        String?             @db.VarChar(120)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions           UserSession[]
  memberships        BusinessMember[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  idempotencyRecords IdempotencyRecord[]
  syncRecords        SyncRecord[]
  subscriptionOrders SubscriptionOrder[]
  manualPaymentSubmissions SubscriptionManualPaymentSubmission[]
  businessCreationRequests BusinessCreationRequest[]
  onboardingEvents OnboardingEvent[]
  onboardingResultViews OnboardingResultView[]

  @@map("users")
}

model SystemAdmin {
  id                         String                       @id @default(uuid()) @db.Uuid
  phone                      String                       @unique @db.VarChar(20)
  displayName                String                       @map("display_name") @db.VarChar(120)
  isActive                   Boolean                      @default(true) @map("is_active")
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions                   SystemAdminSession[]
  auditEvents                SystemAdminAuditEvent[]
  subscriptionPriceVersions  SubscriptionPriceVersion[]
  subscriptionPeriods        SubscriptionPeriod[]
  subscriptionRolloutUpdates SubscriptionRolloutSetting[] @relation("SubscriptionRolloutUpdater")
  manualPaymentSettingsUpdates SubscriptionManualPaymentSettings[] @relation("ManualPaymentSettingsUpdater")
  reviewedManualPayments      SubscriptionManualPaymentSubmission[] @relation("ManualPaymentReviewer")

  @@map("system_admins")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  csrfHash  String    @map("csrf_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model SystemAdminSession {
  id        String      @id @default(uuid()) @db.Uuid
  adminId   String      @map("admin_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  csrfHash  String      @map("csrf_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("system_admin_sessions")
}

model SystemAdminAuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  adminId    String      @map("admin_id") @db.Uuid
  action     String      @db.VarChar(80)
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.Uuid
  requestId  String      @map("request_id") @db.VarChar(80)
  metadata   Json?
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  admin      SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("system_admin_audit_events")
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @db.VarChar(20)
  purpose       OtpPurpose
  codeHash      String     @map("code_hash") @db.Char(64)
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts      Int        @default(0)
  consumedAt    DateTime?  @map("consumed_at") @db.Timestamptz(6)
  requestIpHash String?    @map("request_ip_hash") @db.Char(64)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

model Business {
  id                   String               @id @default(uuid()) @db.Uuid
  displayName          String               @map("display_name") @db.VarChar(160)
  businessType         String               @map("business_type") @db.VarChar(80)
  timezone             String               @default("Asia/Tehran") @db.VarChar(64)
  baseCurrency         String               @default("IRR") @map("base_currency") @db.Char(3)
  displayCurrency      DisplayCurrency      @default(IRT) @map("display_currency")
  locale               String               @default("fa-IR") @db.VarChar(12)
  calendar             String               @default("jalali") @db.VarChar(12)
  inventoryEnabled     Boolean              @default(true) @map("inventory_enabled")
  negativeStockAllowed Boolean              @default(false) @map("negative_stock_allowed")
  settingsVersion      Int                  @default(1) @map("settings_version")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  members              BusinessMember[]
  branches             Branch[]
  units                Unit[]
  categories           ProductCategory[]
  products             Product[]
  parties              Party[]
  financeAccounts      FinanceAccount[]
  ledgerAccounts       LedgerAccount[]
  salesInvoices        SalesInvoice[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchases            Purchase[]
  purchaseLines        PurchaseLine[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  cashTransactions     CashTransaction[]
  inventoryMovements   InventoryMovement[]
  inventoryBalances    InventoryBalance[]
  stockCounts          StockCount[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  auditEvents          AuditEvent[]
  idempotencyRecords   IdempotencyRecord[]
  syncRecords          SyncRecord[]
  sequences            DocumentSequence[]
  closedPeriods        ClosedPeriod[]
  attachments          Attachment[]
  cashCloses           CashClose[]
  branchSubscriptions  BranchSubscription[]
  subscriptionOrders   SubscriptionOrder[]
  subscriptionPeriods  SubscriptionPeriod[]
  onboardingProgress   OnboardingProgress[]
  onboardingEvents     OnboardingEvent[]
  onboardingResultViews OnboardingResultView[]
  businessCreationRequests BusinessCreationRequest[]
  storefronts            Storefront[]
  storefrontListings     StorefrontListing[]
  storefrontOrders       StorefrontOrder[]
  storefrontPaymentCards StorePaymentCard[]
  storefrontOtpGrants    StorefrontOtpGrant[]
  storefrontReservations StorefrontReservation[]
  storefrontOrderItems   StorefrontOrderItem[]
  storefrontPaymentAttempts StorefrontPaymentAttempt[]
  storefrontOrderEvents  StorefrontOrderEvent[]

  @@map("businesses")
}

model BusinessMember {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       MemberRole       @default(CASHIER)
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches   MemberBranch[]

  @@unique([businessId, userId])
  @@unique([id, businessId])
  @@index([userId, status])
  @@map("business_members")
}

model Branch {
  id                  String               @id @default(uuid()) @db.Uuid
  businessId          String               @map("business_id") @db.Uuid
  name                String               @db.VarChar(120)
  code                String               @db.VarChar(24)
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members             MemberBranch[]
  invoices            SalesInvoice[]
  purchases           Purchase[]
  expenses            Expense[]
  accounts            FinanceAccount[]
  cashTx              CashTransaction[]
  balances            InventoryBalance[]
  movements           InventoryMovement[]
  stockCounts         StockCount[]
  journals            JournalEntry[]
  journalLines        JournalLine[]
  cashCloses          CashClose[]
  subscription        BranchSubscription[]
  subscriptionOrders  SubscriptionOrder[]
  subscriptionPeriods SubscriptionPeriod[]
  syncRecords         SyncRecord[]
  onboardingProgress  OnboardingProgress[]
  onboardingEvents    OnboardingEvent[]
  onboardingResultViews OnboardingResultView[]
  businessCreationRequests BusinessCreationRequest[]
  storefront               Storefront?
  storefrontListings       StorefrontListing[]
  storefrontOrders         StorefrontOrder[]
  storefrontPaymentCards   StorePaymentCard[]
  storefrontOtpGrants      StorefrontOtpGrant[]
  storefrontReservations   StorefrontReservation[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@map("branches")
}

model MemberBranch {
  memberId   String         @map("member_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  branchId   String         @map("branch_id") @db.Uuid
  grantedAt  DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  member     BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  branch     Branch         @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@id([memberId, branchId])
  @@index([businessId, branchId])
  @@map("member_branches")
}

model BusinessCreationRequest {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  key         String   @db.VarChar(128)
  requestHash String   @map("request_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([userId, key])
  @@index([businessId, branchId])
  @@map("business_creation_requests")
}

model OnboardingProgress {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  branchId           String   @map("branch_id") @db.Uuid
  financialStartMode String?  @map("financial_start_mode") @db.VarChar(24)
  skippedSteps       String[] @default([]) @map("skipped_steps")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch             Branch   @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, branchId])
  @@map("onboarding_progress")
}

model OnboardingResultView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, branchId, userId])
  @@index([userId, viewedAt])
  @@map("onboarding_result_views")
}

model Storefront {
  id                     String             @id @default(uuid()) @db.Uuid
  businessId             String             @map("business_id") @db.Uuid
  branchId               String             @unique @map("branch_id") @db.Uuid
  slug                   String             @unique @db.VarChar(80)
  status                 StorefrontStatus   @default(DRAFT)
  publicName             String             @map("public_name") @db.VarChar(120)
  description            String?            @db.VarChar(1000)
  phone                  String?            @db.VarChar(20)
  address                String?            @db.VarChar(500)
  showAddress            Boolean            @default(false) @map("show_address")
  acceptsPickup          Boolean            @default(true) @map("accepts_pickup")
  acceptsLocalDelivery   Boolean            @default(false) @map("accepts_local_delivery")
  deliveryFeeRial        BigInt             @default(0) @map("delivery_fee_rial")
  showExactStock         Boolean            @default(false) @map("show_exact_stock")
  preparationMinutes     Int?               @map("preparation_minutes")
  paymentInstructions    String?            @map("payment_instructions") @db.VarChar(1000)
  cancellationPolicy     String?            @map("cancellation_policy") @db.VarChar(1000)
  createdBy              String             @map("created_by") @db.Uuid
  updatedBy              String             @map("updated_by") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                 Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  listings               StorefrontListing[]
  orders                 StorefrontOrder[]
  otpGrants              StorefrontOtpGrant[]

  @@unique([id, branchId])
  @@unique([id, businessId])
  @@unique([branchId, businessId])
  @@index([status, updatedAt])
  @@map("storefronts")
}

model StorefrontListing {
  id                 String                    @id @default(uuid()) @db.Uuid
  businessId         String                    @map("business_id") @db.Uuid
  branchId           String                    @map("branch_id") @db.Uuid
  storefrontId       String                    @map("storefront_id") @db.Uuid
  productId          String                    @map("product_id") @db.Uuid
  publicTitle        String?                   @map("public_title") @db.VarChar(160)
  publicDescription  String?                   @map("public_description") @db.VarChar(1000)
  publicPriceRial    BigInt?                   @map("public_price_rial")
  isPublished        Boolean                   @default(false) @map("is_published")
  canOrder           Boolean                   @default(true) @map("can_order")
  stockPolicy        StorefrontListingStockPolicy @default(APPROXIMATE) @map("stock_policy")
  minimumQuantity    Decimal                   @default(1) @map("minimum_quantity") @db.Decimal(18, 3)
  maximumQuantity    Decimal?                  @map("maximum_quantity") @db.Decimal(18, 3)
  displayOrder       Int                       @default(0) @map("display_order")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch             Branch                    @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  storefront         Storefront                @relation(fields: [storefrontId, branchId], references: [id, branchId], onDelete: Restrict)
  product            Product                   @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  orderItems         StorefrontOrderItem[]

  @@unique([branchId, productId])
  @@unique([id, businessId, branchId])
  @@unique([id, businessId])
  @@index([storefrontId, isPublished, displayOrder])
  @@map("storefront_listings")
}

model StorePaymentCard {
  id                String         @id @default(uuid()) @db.Uuid
  businessId        String         @map("business_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  financeAccountId  String         @map("finance_account_id") @db.Uuid
  bankName          String         @map("bank_name") @db.VarChar(80)
  holderName        String         @map("holder_name") @db.VarChar(120)
  cardNumberEncrypted String       @map("card_number_encrypted") @db.VarChar(512)
  cardLast4         String         @map("card_last4") @db.Char(4)
  label             String?        @db.VarChar(80)
  instructions      String?        @db.VarChar(500)
  displayOrder      Int            @default(0) @map("display_order")
  isActive          Boolean        @default(true) @map("is_active")
  createdBy         String         @map("created_by") @db.Uuid
  updatedBy         String         @map("updated_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch            Branch         @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  financeAccount    FinanceAccount @relation(fields: [financeAccountId, businessId], references: [id, businessId], onDelete: Restrict)
  attempts          StorefrontPaymentAttempt[]

  @@unique([id, businessId])
  @@index([businessId, branchId, isActive, displayOrder])
  @@map("store_payment_cards")
}

model StorefrontOtpGrant {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  storefrontId String     @map("storefront_id") @db.Uuid
  phone       String      @db.VarChar(20)
  tokenHash   String      @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)
  storefront  Storefront  @relation(fields: [storefrontId, branchId], references: [id, branchId], onDelete: Cascade)

  @@index([storefrontId, phone, expiresAt])
  @@map("storefront_otp_grants")
}

model StorefrontRateLimitBucket {
  fingerprint String   @db.Char(64)
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  requestCount Int     @default(0) @map("request_count")

  @@id([fingerprint, bucketStart])
  @@index([bucketStart])
  @@map("storefront_rate_limit_buckets")
}

model StorefrontOrder {
  id                   String                    @id @default(uuid()) @db.Uuid
  businessId           String                    @map("business_id") @db.Uuid
  branchId             String                    @map("branch_id") @db.Uuid
  storefrontId         String                    @map("storefront_id") @db.Uuid
  publicCode           String                    @unique @map("public_code") @db.VarChar(32)
  trackingTokenHash    String                    @unique @map("tracking_token_hash") @db.Char(64)
  idempotencyKey       String                    @map("idempotency_key") @db.VarChar(128)
  requestHash          String                    @map("request_hash") @db.Char(64)
  customerName         String                    @map("customer_name") @db.VarChar(120)
  customerPhone        String                    @map("customer_phone") @db.VarChar(20)
  customerPartyId      String?                   @map("customer_party_id") @db.Uuid
  deliveryMethod       StorefrontDeliveryMethod  @map("delivery_method")
  deliveryAddress      String?                   @map("delivery_address") @db.VarChar(500)
  customerNote         String?                   @map("customer_note") @db.VarChar(500)
  status               StorefrontOrderStatus     @default(SUBMITTED)
  paymentStatus        StorefrontPaymentStatus   @default(NOT_DUE) @map("payment_status")
  subtotalRial         BigInt                    @map("subtotal_rial")
  taxRial              BigInt                    @map("tax_rial")
  deliveryFeeRial      BigInt                    @map("delivery_fee_rial")
  totalRial            BigInt                    @map("total_rial")
  paymentDueAt         DateTime?                 @map("payment_due_at") @db.Timestamptz(6)
  reservationExpiresAt DateTime?                 @map("reservation_expires_at") @db.Timestamptz(6)
  acceptedAt           DateTime?                 @map("accepted_at") @db.Timestamptz(6)
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch               Branch                    @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  storefront           Storefront                @relation(fields: [storefrontId, branchId], references: [id, branchId], onDelete: Restrict)
  customerParty        Party?                    @relation(fields: [customerPartyId, businessId], references: [id, businessId], onDelete: Restrict)
  items                StorefrontOrderItem[]
  paymentAttempts      StorefrontPaymentAttempt[]
  events               StorefrontOrderEvent[]
  reservations          StorefrontReservation[]
  salesInvoice         SalesInvoice?

  @@unique([businessId, branchId, idempotencyKey])
  @@unique([id, businessId, branchId])
  @@unique([id, businessId])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, branchId, paymentStatus, createdAt])
  @@map("storefront_orders")
}

model StorefrontOrderItem {
  id                  String             @id @default(uuid()) @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  branchId            String             @map("branch_id") @db.Uuid
  orderId             String             @map("order_id") @db.Uuid
  listingId           String?            @map("listing_id") @db.Uuid
