model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, key])
  @@map("idempotency_records")
}

model SyncRecord {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @map("business_id") @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  branchId          String?    @map("branch_id") @db.Uuid
  deviceId          String     @map("device_id") @db.VarChar(120)
  clientOperationId String     @map("client_operation_id") @db.Uuid
  operationType     String     @map("operation_type") @db.VarChar(60)
  payloadHash       String     @map("payload_hash") @db.Char(64)
  status            SyncStatus @default(PENDING)
  serverEntityId    String?    @map("server_entity_id") @db.Uuid
  errorCode         String?    @map("error_code") @db.VarChar(64)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user              User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch            Branch?    @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, deviceId, clientOperationId])
  @@index([businessId, status, createdAt])
  @@index([businessId, userId, branchId, updatedAt])
  @@map("sync_records")
}

model DocumentSequence {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  type       String   @db.VarChar(32)
  nextValue  BigInt   @default(1) @map("next_value")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@map("document_sequences")
}

model SubscriptionPlan {
  id           String                     @id @default(uuid()) @db.Uuid
  code         String                     @unique @db.VarChar(24)
  nameFa       String                     @map("name_fa") @db.VarChar(80)
  displayOrder Int                        @default(0) @map("display_order")
  isActive     Boolean                    @default(true) @map("is_active")
  badge        String?                    @db.VarChar(80)
  features     Json                       @default("[]")
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  prices       SubscriptionPriceVersion[]
  orders       SubscriptionOrder[]
  periods      SubscriptionPeriod[]

  @@index([isActive, displayOrder])
  @@map("subscription_plans")
}

model SubscriptionPriceVersion {
  id             String              @id @default(uuid()) @db.Uuid
  planId         String              @map("plan_id") @db.Uuid
  durationMonths Int                 @map("duration_months")
  priceRial      BigInt              @map("price_rial")
  currency       String              @default("IRR") @db.Char(3)
  effectiveFrom  DateTime            @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?           @map("effective_to") @db.Timestamptz(6)
  createdById    String              @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  plan           SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy      SystemAdmin         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  orders         SubscriptionOrder[]

  @@unique([planId, durationMonths, effectiveFrom])
  @@map("subscription_price_versions")
}

model BranchSubscription {
  id               String               @id @default(uuid()) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  suspendedAt      DateTime?            @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?              @map("suspension_reason") @db.VarChar(500)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch               @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  orders           SubscriptionOrder[]
  periods          SubscriptionPeriod[]

  @@unique([businessId, branchId])
  @@unique([id, businessId, branchId])
  @@index([businessId, updatedAt])
  @@map("branch_subscriptions")
}

model SubscriptionOrder {
  id                            String                                @id @default(uuid()) @db.Uuid
  businessId                    String                                @map("business_id") @db.Uuid
  branchId                      String                                @map("branch_id") @db.Uuid
  branchSubscriptionId          String                                @map("branch_subscription_id") @db.Uuid
  planId                        String                                @map("plan_id") @db.Uuid
  priceVersionId                String                                @map("price_version_id") @db.Uuid
  createdById                   String                                @map("created_by_id") @db.Uuid
  idempotencyKey                String                                @map("idempotency_key") @db.VarChar(128)
  planCodeSnapshot              String                                @map("plan_code_snapshot") @db.VarChar(24)
  planNameFaSnapshot            String                                @map("plan_name_fa_snapshot") @db.VarChar(80)
  durationMonths                Int                                   @map("duration_months")
  amountRial                    BigInt                                @map("amount_rial")
  currency                      String                                @default("IRR") @db.Char(3)
  status                        SubscriptionOrderStatus               @default(PENDING)
  providerReference             String?                               @unique @map("provider_reference") @db.VarChar(160)
  manualPaymentSettingsSnapshot Json?                                 @map("manual_payment_settings_snapshot")
  createdAt                     DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt                        DateTime?                             @map("paid_at") @db.Timestamptz(6)
  business                      Business                              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                        Branch                                @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  branchSubscription            BranchSubscription                    @relation(fields: [branchSubscriptionId, businessId, branchId], references: [id, businessId, branchId], onDelete: Restrict)
  plan                          SubscriptionPlan                      @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceVersion                  SubscriptionPriceVersion              @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  createdBy                     User                                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attempts                      SubscriptionPaymentAttempt[]
  periods                       SubscriptionPeriod[]
  manualPaymentSubmissions      SubscriptionManualPaymentSubmission[]

  @@unique([businessId, branchId, idempotencyKey])
  @@unique([id, businessId, branchId])
  @@index([businessId, branchId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_orders")
}

model SubscriptionManualPaymentSettings {
  id                    String       @id @default("global") @db.VarChar(16)
  enabled               Boolean      @default(true)
  cardNumber            String       @default("6219861995926549") @map("card_number") @db.VarChar(32)
  cardHolder            String       @default("محمدصالح محمدی") @map("card_holder") @db.VarChar(120)
  bankName              String?      @map("bank_name") @db.VarChar(80)
  instructions          String?      @db.VarChar(1000)
  telegramContactHandle String       @default("@tiaammhd") @map("telegram_contact_handle") @db.VarChar(64)
  telegramTargetChatId  String?      @map("telegram_target_chat_id") @db.VarChar(80)
  updatedById           String?      @map("updated_by_id") @db.Uuid
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             SystemAdmin? @relation("ManualPaymentSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("subscription_manual_payment_settings")
}

model SubscriptionManualPaymentSubmission {
  id                String                     @id @default(uuid()) @db.Uuid
  orderId           String                     @map("order_id") @db.Uuid
  paymentAttemptId  String                     @unique @map("payment_attempt_id") @db.Uuid
  submittedById     String                     @map("submitted_by_id") @db.Uuid
  reviewStatus      ManualPaymentReviewStatus  @default(PENDING_REVIEW) @map("review_status")
  trackingCode      String?                    @map("tracking_code") @db.VarChar(120)
  storageKey        String                     @unique @map("storage_key") @db.VarChar(500)
  fileName          String                     @map("file_name") @db.VarChar(255)
  mimeType          String                     @map("mime_type") @db.VarChar(120)
  bytes             BigInt
  checksum          String                     @db.Char(64)
  telegramStatus    TelegramDeliveryStatus     @default(NOT_CONFIGURED) @map("telegram_status")
  telegramMessageId String?                    @map("telegram_message_id") @db.VarChar(40)
  telegramErrorCode String?                    @map("telegram_error_code") @db.VarChar(80)
  reviewedByAdminId String?                    @map("reviewed_by_admin_id") @db.Uuid
  rejectionReason   String?                    @map("rejection_reason") @db.VarChar(500)
  submittedAt       DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  order             SubscriptionOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentAttempt    SubscriptionPaymentAttempt @relation(fields: [paymentAttemptId, orderId], references: [id, orderId], onDelete: Restrict)
  submittedBy       User                       @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedByAdmin   SystemAdmin?               @relation("ManualPaymentReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([paymentAttemptId, orderId])
  @@index([reviewStatus, submittedAt])
  @@index([orderId, submittedAt])
  @@map("subscription_manual_payment_submissions")
}

model SubscriptionPeriod {
  id                   String                   @id @default(uuid()) @db.Uuid
  businessId           String                   @map("business_id") @db.Uuid
  branchId             String                   @map("branch_id") @db.Uuid
  branchSubscriptionId String                   @map("branch_subscription_id") @db.Uuid
  orderId              String?                  @map("order_id") @db.Uuid
  planId               String?                  @map("plan_id") @db.Uuid
  source               SubscriptionPeriodSource
  planCodeSnapshot     String?                  @map("plan_code_snapshot") @db.VarChar(24)
  planNameFaSnapshot   String?                  @map("plan_name_fa_snapshot") @db.VarChar(80)
  durationMonths       Int?                     @map("duration_months")
  startsAt             DateTime                 @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime                 @map("ends_at") @db.Timestamptz(6)
  revokedAt            DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revocationReason     String?                  @map("revocation_reason") @db.VarChar(500)
  actorAdminId         String?                  @map("actor_admin_id") @db.Uuid
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  business             Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch               Branch                   @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  branchSubscription   BranchSubscription       @relation(fields: [branchSubscriptionId, businessId, branchId], references: [id, businessId, branchId], onDelete: Restrict)
  order                SubscriptionOrder?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  plan                 SubscriptionPlan?        @relation(fields: [planId], references: [id], onDelete: Restrict)
  actorAdmin           SystemAdmin?             @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([businessId, branchId, startsAt, endsAt])
  @@map("subscription_periods")
}

model SubscriptionPaymentAttempt {
  id                 String                               @id @default(uuid()) @db.Uuid
  businessId         String                               @map("business_id") @db.Uuid
  branchId           String                               @map("branch_id") @db.Uuid
  orderId            String                               @map("order_id") @db.Uuid
  provider           String                               @db.VarChar(40)
  providerExternalId String?                              @unique @map("provider_external_id") @db.VarChar(160)
  amountRial         BigInt                               @map("amount_rial")
  currency           String                               @default("IRR") @db.Char(3)
  status             SubscriptionPaymentStatus            @default(INITIATED)
  safeErrorCode      String?                              @map("safe_error_code") @db.VarChar(80)
  createdAt          DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?                            @map("completed_at") @db.Timestamptz(6)
  order              SubscriptionOrder                    @relation(fields: [orderId, businessId, branchId], references: [id, businessId, branchId], onDelete: Restrict)
  manualSubmission   SubscriptionManualPaymentSubmission?

  @@unique([id, orderId])
  @@index([businessId, branchId, createdAt])
  @@index([orderId, createdAt])
  @@map("subscription_payment_attempts")
}

model SubscriptionRolloutSetting {
  id                      String                  @id @default("global") @db.VarChar(16)
  mode                    SubscriptionRolloutMode @default(OBSERVE)
  legacyGraceEndsAt       DateTime?               @map("legacy_grace_ends_at") @db.Timestamptz(6)
  providerFeeBasisPoints  Int?                    @map("provider_fee_basis_points")
  taxRateBasisPoints      Int?                    @map("tax_rate_basis_points")
  variableCostRial        BigInt?                 @map("variable_cost_rial")
  minimumContributionRial BigInt?                 @map("minimum_contribution_rial")
  updatedById             String?                 @map("updated_by_id") @db.Uuid
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy               SystemAdmin?            @relation("SubscriptionRolloutUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("subscription_rollout_settings")
}
